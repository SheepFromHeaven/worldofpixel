{
  "name": "element-circuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless deterministic simulation engine for Element Circuit (Phase 1, CLI only)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "sim": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:bridge": "tsx src/cli/bridgeCheck.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.3.2",
    "rete-connection-plugin": "^2.0.5",
    "rete-react-plugin": "^2.1.2",
    "rete-render-utils": "^2.0.3",
    "styled-components": "^6.6.0"
  }
}
