{
  "name": "scribble-empire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scribble Empire — a four-layer hand-drawn logistics simulation",
  "scripts": {
    "dev": "vite",
    "lab": "vite --open /lab",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "sim": "tsx src/cli/index.ts",
    "sprites": "tsx src/cli/sprites.ts",
    "terrain": "tsx src/cli/terrainPreview.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ui": "tsx src/cli/ui.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
