{
  "name": "scribble-empire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scribble Empire \u2014 a four-layer hand-drawn logistics simulation",
  "scripts": {
    "dev": "tsx tools/modules.ts && vite",
    "zoo": "tsx tools/modules.ts && vite --open /zoo",
    "animal": "tsx tools/animalSheet.ts",
    "studio": "tsx tools/modules.ts && vite --open /studio",
    "build": "tsx tools/modules.ts && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "sprites": "tsx tools/sprites.ts",
    "ground": "tsx tools/ground.ts",
    "props": "tsx tools/props.ts",
    "trees": "tsx tools/trees.ts",
    "closeup": "tsx tools/closeup.ts",
    "ground:preview": "tsx tools/groundPreview.ts",
    "terrain": "tsx tools/terrainPreview.ts",
    "strata": "tsx tools/strataPreview.ts",
    "typecheck": "tsx tools/modules.ts && tsc -p tsconfig.json --noEmit && tsx tools/moduleCheck.ts --strict",
    "ui": "tsx tools/ui.ts",
    "planet": "tsx tools/planetPreview.ts",
    "ui:preview": "tsx tools/uiPreview.ts",
    "wiki": "tsx tools/wiki/index.ts",
    "foodweb": "tsx tools/foodweb.ts",
    "mind": "tsx tools/mindSheet.ts",
    "shot": "tsx tools/shot.ts",
    "rivers": "CHECK=plain MODES=plain tsx tools/riverTest.ts",
    "sim": "tsx tools/dev.ts",
    "content": "tsx tools/contentCheck.ts",
    "modules": "tsx tools/modules.ts",
    "modules:check": "tsx tools/moduleCheck.ts",
    "modules:new": "tsx tools/newModule.ts",
    "scenario": "tsx tools/scenario.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
